# The HID drivers (usbkbd, usbmouse) are hosted INSIDE the `usb` daemon, linked
# via USB_HOSTDRV_LIBS in build-core-aarch64a72-generic.sh — so only their static
# libs are needed here. The standalone usbkbd/usbmouse binaries are intentionally
# omitted: with the daemon built -DUSB_INTERNAL_ONLY they have no connect path and
# would just fail with "unsupported usb_msg type: 0".
DEFAULT_COMPONENTS := pl011-tty libusbxhci libusbdrv-usbkbd libusbdrv-usbmouse
# USB mass storage (BOT/SCSI): the same in-daemon hosting as the HID drivers, so a
# USB stick enumerates as /dev/umass0 and can be mounted while the system runs. The
# driver itself is upstream and unchanged; it had simply never been built for this
# target. Add it to USB_HOSTDRV_LIBS in build-core-aarch64a72-generic.sh too -- the
# component alone builds the lib but nothing links it, and the stick then enumerates
# with no driver bound (the exact shape of the #126 mouse bug).
DEFAULT_COMPONENTS += libusbdrv-umass
# BCM2711 EMMC2 SD-card block driver (rootfs storage). DEP_LIBS pulls in
# libsdcard-bcm2711 (generic SDHCI core + bcm2711 platform layer).
DEFAULT_COMPONENTS += bcm2711-emmc
# VideoCore property-mailbox server (/dev/vcmbox) + its client lib (libvcmbox).
# Owns the single, hardware-arbitration-free mailbox FIFO at 0xfe00b880 and
# serializes every property call, so the multiple boot-time mailbox clients
# (thermal, genet MAC read, VL805 bring-up, sdio, v3d power-on) no longer race
# and destroy each other's responses. Must be listed (and launched) FIRST among
# the mailbox users. The lib is pulled in via DEP_LIBS where it is consumed.
DEFAULT_COMPONENTS += rpi4-vcmbox
# SoC thermal / throttle telemetry via the VideoCore property mailbox
# (/dev/thermal, /dev/throttled), now routed through rpi4-vcmbox. Telemetry
# only - the firmware owns the trip.
DEFAULT_COMPONENTS += rpi4-thermal
# Hardware RNG (BCM2711 iproc RNG200 @ 0xfe104000) -> /dev/hwrng entropy source.
DEFAULT_COMPONENTS += rpi4-hwrng
# BCM2711 GPIO observer (/dev/gpio @ 0xfe200000): read-only register snapshot +
# per-pin {fsel,level,pull} devctl. Outputs deferred to an attended bench session.
DEFAULT_COMPONENTS += rpi4-gpio
# BCM2711 PWM audio (/dev/audio0): 3.5mm jack via PWM1 on GPIO40/41 (ALT0), CPRMAN
# PWM clock ~44.1kHz, mark/space + FIFO. write() = s16 PCM -> FIFO (PIO). Clock/PWM
# bring-up is self-logged; audible sign-off + DMA streaming are follow-ups.
DEFAULT_COMPONENTS += rpi4-audio
# Boot system-info banner: build stamp, uptime, a hardware-RNG entropy sample, and a
# Pi 4 device-node inventory. Bounded/non-blocking (stat/getentropy/clock); "alive" touch.
DEFAULT_COMPONENTS += rpi4-sysinfo
# The GPU stack (DRM-shaped), started at boot from user.plo.yaml in this order:
#  - rpi4-v3d-async: the V3D render server (/dev/v3d-async, /dev/dri/renderD128,
#    /dev/dri/card1, /v3dbuf): sole owner of the GPU, async queues, fences, BOs.
#  - rpi4-kms: the display server (/dev/kms = /dev/dri/card0, /kmsbuf): firmware
#    planes, vblank events, atomic flips gated on the render server's fences (-G).
#  - shmsrv: anonymous shared memory (/shm) for Wayland wl_shm and DRI3 xshmfence.
# Clients reach them through libdrm (the libdrm_phoenix port), Mesa (mesa_drm), SDL2
# KMSDRM (sdl2_kmsdrm), Xorg modesetting (xorg_server_drm) and Wayland.
DEFAULT_COMPONENTS += rpi4-v3d-async rpi4-kms shmsrv
# BCM43455 WiFi: the rpi4-wifi daemon owns the chip on the Arasan SDIO bus and serves
# /dev/wifi (commands) + /dev/wifidata (frames for the lwip wifi43455 netif); `wifi`
# (/bin) is the user's control client. Started at boot from user.plo.yaml. It reads
# the vendor firmware from /lib/firmware/brcm/ (fetched by the image build, never in
# git) and, without it, logs one line and exits: the image builds either way.
DEFAULT_COMPONENTS += rpi4-wifi wifi
# Kernel-log capture daemon (task #31): reads the klog ring and appends it to
# /var/log/messages. Always bundled (a few KB); only LAUNCHED in the USER logging
# mode (RPI4_LOG_TO_FILE), where it is the file-capture half of suppressing the
# verbose klog from the console. View the file with the `logread` psh builtin.
DEFAULT_COMPONENTS += rpi4-klogd
# rpi4-ipcprobe: one-shot userspace-API readiness probe (misc/rpi4-ipcprobe/) — AF_UNIX
# (socketpair + named bind/listen/accept/connect/send/recv) + libc entropy (getrandom/
# getentropy). NOT a default component (re-add here + to user.plo.yaml to re-run).
# Verdict 2026-06-17: AF_UNIX READY + getrandom/getentropy READY (HW-verified).
# DEFAULT_COMPONENTS += rpi4-ipcprobe
# Removed, recoverable from git history: the V3D bring-up probes and GL demo rungs, and
# the first GPU stack (the in-process Mesa winsys + its build scripts, its GPU daemon on
# /dev/v3d-srv and that daemon's client library), superseded by rpi4-v3d-async + rpi4-kms. The games are ports
# (phoenix-rtos-ports *_drm), not device components.
# Note: the standalone `pcie` daemon is intentionally NOT listed here.
# Pi 4 (the only aarch64a72 project today) merges PCIe bridge bring-up
# into the usb daemon via libusbxhci's bcm2711_pcie_initVL805(), so
# the daemon is unused. Re-add `pcie` only if a new a72 board needs
# the separate-daemon pattern.
