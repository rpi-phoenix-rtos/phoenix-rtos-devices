# The HID drivers (usbkbd, usbmouse) are hosted INSIDE the `usb` daemon, linked
# via USB_HOSTDRV_LIBS in build-core-aarch64a72-generic.sh — so only their static
# libs are needed here. The standalone usbkbd/usbmouse binaries are intentionally
# omitted: with the daemon built -DUSB_INTERNAL_ONLY they have no connect path and
# would just fail with "unsupported usb_msg type: 0".
DEFAULT_COMPONENTS := pl011-tty libusbxhci libusbdrv-usbkbd libusbdrv-usbmouse
# BCM2711 EMMC2 SD-card block driver (rootfs storage). DEP_LIBS pulls in
# libsdcard-bcm2711 (generic SDHCI core + bcm2711 platform layer).
DEFAULT_COMPONENTS += bcm2711-emmc
# SoC thermal / throttle telemetry via the VideoCore property mailbox
# (/dev/thermal, /dev/throttled). Telemetry only - the firmware owns the trip.
DEFAULT_COMPONENTS += rpi4-thermal
# Hardware RNG (BCM2711 iproc RNG200 @ 0xfe104000) -> /dev/hwrng entropy source.
DEFAULT_COMPONENTS += rpi4-hwrng
# VideoCore HDMI framebuffer (/dev/fb0): read/write byte access + geometry
# devctl over the plo-allocated 32-bpp surface (pctl_graphmode + MAP_PHYSMEM).
DEFAULT_COMPONENTS += rpi4-fb
# BCM2711 GPIO observer (/dev/gpio @ 0xfe200000): read-only register snapshot +
# per-pin {fsel,level,pull} devctl. Outputs deferred to an attended bench session.
DEFAULT_COMPONENTS += rpi4-gpio
# V3D GPU scout (Tier 3, GLQuake roadmap): powers on the V3D domain via the
# mailbox + raw-dumps the V3D MMIO identity region to confirm the core is alive.
DEFAULT_COMPONENTS += rpi4-v3d-scout
# Mesa v3d driver harness (GLQuake Path C): links the ported Mesa v3d gallium
# driver (libv3d-phoenix.a) + runs v3d_screen_create on HW. Boot-launched in the
# netboot variant (see user.plo.yaml). Large (~11 MB: it pulls in the Mesa
# compiler/NIR). Requires /tmp/libv3d-phoenix.a (tools/v3d-driver-port build).
# rpi4-v3d-mesa dropped from the bundle while validating the GL frontend: both
# harnesses together (~11+18 MB) would overflow loader.disk. Re-add to compare.
# DEFAULT_COMPONENTS += rpi4-v3d-mesa
# Mesa OpenGL glClear harness (GLQuake Path C, Phase 4): links the ported Mesa GL
# frontend (libGL-phoenix.a) + v3d driver (libv3d-phoenix.a) and drives a glClear
# through the OpenGL API on HW. Boot-launched in the netboot variant (see
# user.plo.yaml). Large (~18 MB: full Mesa GL stack + GLSL compiler). Requires
# /tmp/libGL-phoenix.a + /tmp/libv3d-phoenix.a (tools/v3d-driver-port build).
# glclear validated (renders green); swapped out for the next rung (gldraw) to
# stay under the loader.disk cap. Re-add to re-run the clear.
# DEFAULT_COMPONENTS += rpi4-glclear
# Mesa OpenGL textured/depth-tested glDrawArrays triangle (GLQuake Path C, Phase 4):
# the rung between glClear and glgears -- exercises the GL frontend's vertex-submission
# + fixed-function shader generation + v3d_compile-at-draw path. Same libs as glclear.
DEFAULT_COMPONENTS += rpi4-gldraw
# Note: the standalone `pcie` daemon is intentionally NOT listed here.
# Pi 4 (the only aarch64a72 project today) merges PCIe bridge bring-up
# into the usb daemon via libusbxhci's bcm2711_pcie_initVL805(), so
# the daemon is unused. Re-add `pcie` only if a new a72 board needs
# the separate-daemon pattern.
